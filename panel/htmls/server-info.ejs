<!DOCTYPE html>
<html>
<head>
    <title>Управление сервером - Discord Bot Admin Panel</title>
    <link rel="stylesheet" href="/css/server-info.css">
    <link rel="stylesheet" href="/css/server-info-chat/context-menus.css">
</head>
<body>
    <div class="header">
        <h1>Управление сервером: <span id="server-name">Загрузка...</span></h1>
        <a href="/dashboard" class="back-btn">← Назад к панели</a>
    </div>

    <div class="section">
        <h2>Информация о сервере</h2>
        <div id="server-info" class="server-info-grid">
            <div class="loading">Загрузка информации...</div>
        </div>
    </div>

    <div class="section">
        <h2>Статистика сервера</h2>
        <div id="server-stats" class="stats-grid">
            <div class="loading">Загрузка статистики...</div>
        </div>
    </div>

    <div class="section">
        <h2>Каналы</h2>
        <div id="server-channels" class="data-list">
            <div class="loading">Загрузка каналов...</div>
        </div>
    </div>

    <div class="section">
        <h2>Роли</h2>
        <div id="server-roles" class="data-list">
            <div class="loading">Загрузка ролей...</div>
        </div>
    </div>

    <div class="section">
        <h2>Вебхуки</h2>
        <div id="server-webhooks" class="data-list">
            <div class="loading">Загрузка вебхуков...</div>
        </div>
    </div>

    <div class="section">
        <h2>Действия</h2>
        <button onclick="window.open('<%= `${serverId}/members` %>', '_self')" class="btn">Список участников</button>
        <button onclick="openModal('send2channel', {serverId: '<%= `${serverId}` %>'})" class="btn">Отправить сообщение на сервер</button>
        <button onclick="refreshStats()" class="btn">Обновить статистику</button>
        <button onclick="exportData()" class="btn">Экспорт данных</button>
        <button onclick="clearData()" class="btn danger">Очистить данные сервера</button>
    </div>

    <div class="section">
        <h2>Последние кейсы модерации</h2>
        <div id="recent-cases">
            <div class="loading">Загрузка кейсов...</div>
        </div>
    </div>

    <script>
        const serverId = '<%= serverId %>';
    </script>
    <script src="/js/server-info-chat/context-menus.js"></script>
    <script src="/js/server-info.js"></script>
</body>
</html>